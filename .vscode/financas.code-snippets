{
  "Base page component": {
    "scope": "typescript,typescriptreact",
    "prefix": "basePage",
    "description": "Cria um componente Page usando o nome da pasta atual.",
    "body": [
      "export default function ${TM_DIRECTORY/.*[\\\\\\\\\\\\/](.*)$/${1:/pascalcase}/}Page() {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ]
  },
  "Base component": {
    "scope": "typescript,typescriptreact",
    "prefix": "baseComponent",
    "description": "Cria um componente usando o nome do arquivo atual.",
    "body": [
      "export default function ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}() {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "}"
    ]
  }
}
