{
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "files.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/node_modules": true,
    "AGENTS.md": true,
    "CLAUDE.md": true,
    "LICENSE": true,
    "eslint.config.mjs": true,
    "next-env.d.ts": true,
    "next.config.ts": true,
    "package-lock.json": true,
    "tsconfig.json": true,
    "scripts": true,
    ".vscode/extensions.json": true,
    ".vscode/financas.code-snippets": true,
    ".gitattributes": true,
    ".gitignore": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/node_modules": true,
    "package-lock.json": true
  }
}
