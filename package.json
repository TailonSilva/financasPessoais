{
  "name": "financas-pessoais",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node src/backend/server.js",
    "db:excluir-receitas": "node src/backend/scripts/excluirTabelaReceitas.js",
    "db:producao": "node src/backend/scripts/criarBancoProducao.js",
    "db:renomear-despesa": "node src/backend/scripts/renomearDespesaParaLancamentos.js",
    "clean:electron": "node scripts/limparBuildElectron.js",
    "server": "npm run dev:server",
    "build": "vite build",
    "electron": "set ELECTRON_RUN_AS_NODE=& electron .",
    "build:electron": "npm run clean:electron && npm run db:producao && npm run build && electron-builder --win nsis --config.directories.output=release-temp && node scripts/publicarBuildElectron.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.financaspessoais.app",
    "productName": "Finanças Pessoais",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "electron/**/*",
      "src/backend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/backend/db.producao.sqlite",
        "to": "db.sqlite"
      }
    ],
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
